MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
PORT=5000
# Device approval is on by default. Set to off only as an emergency switch.
DEVICE_APPROVAL=on
# Owner-only Device Approval panel. Keep these only in Render env, never share with the client.
OWNER_USERNAME=your_owner_username
OWNER_PASSWORD=a_long_random_password
OWNER_JWT_SECRET=a_different_long_random_secret
